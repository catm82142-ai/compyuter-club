<Window x:Class="ComputerClub.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Computer Club" Height="760" Width="1080"
        WindowStyle="None" ResizeMode="NoResize"
        Background="#0B1020" Foreground="#E8ECF5"
        Topmost="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Bloklangan holat -->
        <Grid x:Name="LockView" Grid.Row="0" Grid.RowSpan="3" Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="14" Height="14" Fill="#E5484D" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="Serverga ulanmoqda..."
                           Margin="10,0,0,0" FontSize="18" Foreground="#8B95AB" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="PcName" Text="PC-00" FontSize="72" FontWeight="Bold"
                           HorizontalAlignment="Center" Foreground="#FFFFFF"/>

                <Border Margin="0,32,0,0" Padding="24" CornerRadius="20"
                        Background="#FFFFFF" Width="300" Height="300">
                    <Image x:Name="QrImage" Stretch="Uniform"/>
                </Border>

                <TextBlock Text="To'lov qilish uchun ushbu kodni skan qiling"
                           FontSize="26" Margin="0,36,0,0" HorizontalAlignment="Center"/>

                <TextBlock Text="Payme · Click · Paynet — Xolis orqali"
                           FontSize="18" Margin="0,12,0,0" HorizontalAlignment="Center" Foreground="#8B95AB"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Background="#1B2338" CornerRadius="10" Padding="20,12">
                    <TextBlock x:Name="TariffText" Text="" FontSize="18" Foreground="#8B95AB"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Sessiya holati (kichik oyna) -->
        <Grid x:Name="SessionView" Visibility="Collapsed" Grid.Row="0" Grid.RowSpan="3">
            <Border Background="#121A2E" CornerRadius="16" BorderBrush="#2C3A5A" BorderThickness="1">
                <StackPanel Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="TimerText" Text="00:00" FontSize="52" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="#4ADE80"/>
                    <TextBlock x:Name="GameText" Text="" FontSize="14" Foreground="#4ADE80"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <TextBlock x:Name="PhoneText" Text="" FontSize="15" Foreground="#8B95AB"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <TextBlock Text="Qoldiq vaqt" FontSize="13" Foreground="#5A6478"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>